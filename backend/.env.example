# Local development settings. Copy to backend/.env (never commit .env).
# Matches deploy/compose.dev.yaml.
PMP_DATABASE_URL=postgresql+psycopg://pmp:pmp@localhost:5433/pmp
PMP_SECRET_KEY=change-me-local-dev-only
PMP_LOG_LEVEL=INFO
PMP_LOG_FORMAT=text
PMP_ARTEFACT_DIR=./.artefacts
# The front-end development server runs on plain HTTP (http://localhost:5173), so the
# session cookie must not be marked Secure there. Never set this in production.
PMP_SESSION_COOKIE_SECURE=false
# Notifications (plan 8.5): the Mailpit catcher from deploy/compose.dev.yaml; read the
# e-mails at http://localhost:8025. Production uses the plant's relay on 587 with STARTTLS.
PMP_SMTP_HOST=localhost
PMP_SMTP_PORT=1025
PMP_SMTP_STARTTLS=false
PMP_SMTP_FROM=pmp@localhost
PMP_PUBLIC_URL=http://localhost:5173
