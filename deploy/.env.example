# Settings for the containerised stack (deploy/compose.yaml).
# Copy to deploy/.env (never commit .env).
# Reserved for signing (not read by Release 1: sessions are random server-side tokens).
# Set a long random value anyway so a later release can use it without a config change.
PMP_SECRET_KEY=change-me
PMP_LOG_LEVEL=INFO
PMP_LOG_FORMAT=json
