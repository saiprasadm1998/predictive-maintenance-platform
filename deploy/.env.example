# Settings for the containerised stack (deploy/compose.yaml).
# Copy to deploy/.env and change every "change-me" (never commit .env).

# --- required secrets: long random values, e.g. `openssl rand -hex 32`
POSTGRES_PASSWORD=change-me
PMP_SECRET_KEY=change-me

# --- address and TLS (the Caddy reverse proxy)
PMP_HOSTNAME=localhost
# "internal": Caddy's own certificate authority, for trials (browsers warn). For the
# plant, put the corporate-CA certificate and key in deploy/certs and use:
# PMP_TLS=/certs/pmp.crt /certs/pmp.key
PMP_TLS=internal
# The base of links in e-mails: https:// and the hostname above.
PMP_PUBLIC_URL=https://localhost

# --- sizing (ARC §10.1): web processes 2 x vCPU, at most 8; database cache 25 % of RAM
PMP_WEB_WORKERS=2
PMP_DB_SHARED_BUFFERS=512MB

# --- backups: every day at this UTC time into the "backups" volume (14 daily, 8 weekly)
PMP_BACKUP_AT=02:30

# --- notifications through the plant's SMTP relay (587, STARTTLS); off while unset
# PMP_SMTP_HOST=relay.plant.example
# PMP_SMTP_PORT=587
# PMP_SMTP_USER=pmp
# PMP_SMTP_PASSWORD=change-me
# PMP_SMTP_FROM=pmp@plant.example

# --- logging
PMP_LOG_LEVEL=INFO
PMP_LOG_FORMAT=json
